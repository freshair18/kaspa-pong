                        int phase = launch_phase(epoch,contact_event.index,ball_count,ball_tick_daa);
                        int period = 27*ball_tick_daa;
                        int cycles = (serve-phase+period-1)/period;
                        serve = phase+cycles*period;
                    }
                    hit = serve_ball(serve,contact_event.index,left,right);
                } else {
                    int vy = offset;
                    if (vy < -2) {
                        vy = -2;
                    }
                    if (vy > 2) {
                        vy = 2;
                    }
                    hit = hit.slice(0,16)+byte[]((-OpBin2Num(hit.slice(16,24))) as byte[8])+byte[](vy as byte[8])+hit.slice(32,40);
                }
                active_balls = active_balls.slice(0,contact_event.index*40)+hit+active_balls.slice(contact_event.index*40+40,320);
                if (side == 0) {
                    ly = ny;
                } else {
                    ry = ny;
                }
                at = deadline;
                fresh = -1;
                next_resolver = 1-side;
                next_resolves = next_resolves+1;
            }
            flight = active_balls+byte[](at as byte[8])+byte[](epoch as byte[8])
            +byte[](ly as byte[8])+byte[](ry as byte[8])+byte[](ls as byte[8])+byte[](rs as byte[8])
            +byte[](next_resolver as byte[8])+byte[](next_resolves as byte[8])+byte[](fresh as byte[8]);
        }
        PlayerState[] queues;
        {
            PlayerState q = PlayerState {
                // :: user declared fields
                owner: gen__paddle_state.owner,
                side: side,
                lane: 1,
                checkpoint: byte[24](prefix.slice(128,136)+byte[](16 as byte[8])+byte[](0 as byte[8])),
                t0: read_int(prefix,32),
                t1: read_int(prefix,40),
                t2: read_int(prefix,48),
                t3: read_int(prefix,56),
                d0: queued_dir(prefix,1,0),
                d1: queued_dir(prefix,1,1),
                d2: queued_dir(prefix,1,2),
                d3: queued_dir(prefix,1,3),
            };
            queues = queues.append(q);
        }
        {
            PlayerState q = PlayerState {
                // :: user declared fields
                owner: gen__paddle_state.owner,
                side: side,
                lane: 2,
                checkpoint: byte[24](prefix.slice(136,144)+byte[](16 as byte[8])+byte[](0 as byte[8])),
                t0: read_int(prefix,64),
                t1: read_int(prefix,72),
                t2: read_int(prefix,80),
                t3: read_int(prefix,88),
                d0: queued_dir(prefix,2,0),
                d1: queued_dir(prefix,2,1),
                d2: queued_dir(prefix,2,2),
                d3: queued_dir(prefix,2,3),
            };
            queues = queues.append(q);
        }
        require(tx.outputs[gen__ball_output_idx].value == tx.inputs[this.activeInputIndex].value && tx.outputs[gen__receiver_output_idx].value == tx.inputs[gen__paddle_input_idx].value);
        require(tx.outputs[OpAuthOutputIdx(this.activeInputIndex, 2 + 0)].value == tx.inputs[OpCovInputIdx(gen__cov_id, 2 + 0)].value && tx.outputs[OpAuthOutputIdx(this.activeInputIndex, 2 + 1)].value == tx.inputs[OpCovInputIdx(gen__cov_id, 2 + 1)].value);
        CourtState gen__source_ball_court_state = CourtState {
            // :: user declared fields
            left: left,
            right: right,
            stake_per_player: stake_per_player,
            started: true,
            clock: read_int(flight,320),
            ball_tick_daa: ball_tick_daa,
            balls: byte[320](flight.slice(0,320)),
            ball_count: ball_count,
            win_score: win_score,
            launch_epoch: read_int(flight,328),
            progress: byte[56](flight.slice(336,384)+progress.slice(48,56)),
            response_at: read_int(flight,384),
        };
        State gen__state_ball_state = State {
            // :: generated fields
            gen__collector_template: gen__collector_template,
            gen__court_template: gen__court_template,
            gen__player_template: gen__player_template,
            // :: user declared fields
            left: gen__source_ball_court_state.left,
            right: gen__source_ball_court_state.right,
            stake_per_player: gen__source_ball_court_state.stake_per_player,
            started: gen__source_ball_court_state.started,
            clock: gen__source_ball_court_state.clock,
            ball_tick_daa: gen__source_ball_court_state.ball_tick_daa,
            balls: gen__source_ball_court_state.balls,
            ball_count: gen__source_ball_court_state.ball_count,
            win_score: gen__source_ball_court_state.win_score,
            launch_epoch: gen__source_ball_court_state.launch_epoch,
            progress: gen__source_ball_court_state.progress,
            response_at: gen__source_ball_court_state.response_at,
        };
        // :: become Court
        validateOutputState(gen__ball_output_idx, gen__state_ball_state);
        PlayerState gen__source_receiver_player_state = PlayerState {
            // :: user declared fields
            owner: gen__paddle_state.owner,
            side: side,
            lane: 0,
            checkpoint: byte[24](prefix.slice(120,128)+prefix.slice(144,160)),
            t0: read_int(prefix,0),
            t1: read_int(prefix,8),
            t2: read_int(prefix,16),
            t3: read_int(prefix,24),
            d0: queued_dir(prefix,0,0),
            d1: queued_dir(prefix,0,1),
            d2: queued_dir(prefix,0,2),
            d3: queued_dir(prefix,0,3),
        };
        Gen__PlayerState gen__state_receiver_gen__player_state = Gen__PlayerState {
            // :: generated fields
            gen__collector_template: gen__collector_template,
            gen__court_template: gen__court_template,
            // :: user declared fields
            owner: gen__source_receiver_player_state.owner,
            side: gen__source_receiver_player_state.side,
            lane: gen__source_receiver_player_state.lane,
            checkpoint: gen__source_receiver_player_state.checkpoint,
            t0: gen__source_receiver_player_state.t0,
            t1: gen__source_receiver_player_state.t1,
            t2: gen__source_receiver_player_state.t2,
            t3: gen__source_receiver_player_state.t3,
            d0: gen__source_receiver_player_state.d0,
            d1: gen__source_receiver_player_state.d1,
            d2: gen__source_receiver_player_state.d2,
            d3: gen__source_receiver_player_state.d3,
        };
        // :: become Player
        validateOutputStateWithInputTemplate(
            gen__receiver_output_idx,
            gen__state_receiver_gen__player_state,
            gen__paddle_input_idx,
            gen__player_prefix_len,
            gen__player_suffix_len,
            gen__player_template
        );
        require(queues.length == gen__players_output_count);
        for (gen__players_output_position, 0, gen__players_output_count, 2) {
            PlayerState gen__source_players_player_state = queues[gen__players_output_position];
            Gen__PlayerState gen__state_players_gen__player_state = Gen__PlayerState {
                // :: generated fields
                gen__collector_template: gen__collector_template,
                gen__court_template: gen__court_template,
                // :: user declared fields
                owner: gen__source_players_player_state.owner,
                side: gen__source_players_player_state.side,
                lane: gen__source_players_player_state.lane,
                checkpoint: gen__source_players_player_state.checkpoint,
                t0: gen__source_players_player_state.t0,
                t1: gen__source_players_player_state.t1,
                t2: gen__source_players_player_state.t2,
                t3: gen__source_players_player_state.t3,
                d0: gen__source_players_player_state.d0,
                d1: gen__source_players_player_state.d1,
                d2: gen__source_players_player_state.d2,
                d3: gen__source_players_player_state.d3,
            };
            // :: become Player
            validateOutputStateWithInputTemplate(
                OpAuthOutputIdx(this.activeInputIndex, 2 + gen__players_output_position),
                gen__state_players_gen__player_state,
                gen__paddle_input_idx,
                gen__player_prefix_len,
                gen__player_suffix_len,
                gen__player_template
            );
        }
    }

    // :: leader entry (1:N)
    entry timeout(sig winner_sig, byte[] gen__collector_prefix, byte[] gen__collector_suffix) {
        // :: cov inputs
        byte[32] gen__cov_id = OpInputCovenantId(this.activeInputIndex);
        require(OpCovInputCount(gen__cov_id) == 1);

        // :: auth outputs
        require(OpAuthOutputCount(this.activeInputIndex) == 1);
        // :: output next: Collector
        int gen__next_output_idx = OpAuthOutputIdx(this.activeInputIndex, 0);

        int left_score = read_int(byte[](progress),16);
        int right_score = read_int(byte[](progress),24);
        require(left_score < win_score && right_score < win_score);
        int at = clock;
        int born = OpTxInputDaaScore(this.activeInputIndex);
        require(born >= 0);
        if (!started) {
            at = born;
        }
        ContactState event = ContactState {
            // :: user declared fields
            index: 0,
            side: 0,
            deadline: 0,
        };
        if (started) {
            event = next_event(byte[](balls),ball_count,at,ball_tick_daa);
        } else {
            int serve = born+OPENING_DELAY_DAA;
            int choice = serve_choice(serve,0,left,right);
            int steps = 13;
            int receiver = 1;
            if (choice%2 == 0) {
                steps = 14;
                receiver = 0;
            }
            event = ContactState {
                // :: user declared fields
                index: 0,
                side: receiver,
                deadline: serve+steps*ball_tick_daa,
            };
        }
        int fresh = response_at;
        require(fresh >= -1 && fresh <= born);
        if (fresh == -1) {
            fresh = born;
        }
        int anchor = event.deadline;
        if (fresh > anchor) {
            anchor = fresh;
        }
        int expiry = anchor+RESPONSE_TIMEOUT_DAA;
        if (expiry > born) {
            require(this.ageDaa >= expiry-born);
        }
        int winner = 0;
        pubkey key = left;
        if (event.side == 0) {
            winner = 1;
            key = right;
        }
        require(checkSig(winner_sig,key));
        CollectionState result = CollectionState {
            // :: user declared fields
            left: left,
            right: right,
            stake_per_player: stake_per_player,
            win_score: win_score,
            left_score: left_score,
            right_score: right_score,
            winner: winner,
            end_daa: expiry,
        };
        require(tx.outputs[gen__next_output_idx].value == tx.inputs[this.activeInputIndex].value);
        Gen__CollectorState gen__state_next_gen__collector_state = Gen__CollectorState {
            // :: generated fields
            gen__player_template: gen__player_template,
            // :: user declared fields
            left: result.left,
            right: result.right,
            stake_per_player: result.stake_per_player,
            win_score: result.win_score,
            left_score: result.left_score,
            right_score: result.right_score,
            winner: result.winner,
            end_daa: result.end_daa,
        };
        // :: become Collector
        validateOutputStateWithTemplate(
            gen__next_output_idx,
            gen__state_next_gen__collector_state,
            gen__collector_prefix,
            gen__collector_suffix,
            gen__collector_template
        );
    }

    // :: leader entry (1:N)
    entry settle(byte[] gen__collector_prefix, byte[] gen__collector_suffix) {
        // :: cov inputs
        byte[32] gen__cov_id = OpInputCovenantId(this.activeInputIndex);
        require(OpCovInputCount(gen__cov_id) == 1);

        // :: auth outputs
        require(OpAuthOutputCount(this.activeInputIndex) == 1);
        // :: output next: Collector
        int gen__next_output_idx = OpAuthOutputIdx(this.activeInputIndex, 0);

        int left_score = read_int(byte[](progress),16);
        int right_score = read_int(byte[](progress),24);
        require(left_score == win_score || right_score == win_score);
        int winner = 0;
        if (right_score == win_score) {
            winner = 1;
        }
        CollectionState result = CollectionState {
            // :: user declared fields
            left: left,
            right: right,
            stake_per_player: stake_per_player,
            win_score: win_score,
            left_score: left_score,
            right_score: right_score,
            winner: winner,
            end_daa: clock,
        };
        require(tx.outputs[gen__next_output_idx].value == tx.inputs[this.activeInputIndex].value);
        Gen__CollectorState gen__state_next_gen__collector_state = Gen__CollectorState {
            // :: generated fields
            gen__player_template: gen__player_template,
            // :: user declared fields
            left: result.left,
            right: result.right,
            stake_per_player: result.stake_per_player,
            win_score: result.win_score,
            left_score: result.left_score,
            right_score: result.right_score,
            winner: result.winner,
            end_daa: result.end_daa,
        };
        // :: become Collector
        validateOutputStateWithTemplate(
            gen__next_output_idx,
            gen__state_next_gen__collector_state,
            gen__collector_prefix,
            gen__collector_suffix,
            gen__collector_template
        );
    }

}
