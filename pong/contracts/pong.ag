// Atomic contact-based Pong using Argent's coordinated leader/delegate flow.
// All movement actors remain small. Court authenticates only one side's three
// queues, folds its movement prefix and resolves contact in the same transaction.
// Relative DAA locks bind the boundary to chain time. Movements at or after the
// contact DAA remain queued and cannot retroactively change a hit or miss.
const int COURT_WIDTH = 58;
const int LEFT_CONTACT_X = 2;
const int RIGHT_CONTACT_X = COURT_WIDTH - 3;
const int CENTER_X = COURT_WIDTH / 2;
const int BALL_SPEED = 2;
const int PADDLE_RADIUS = 4;
const int BALL_RADIUS = 1;
const int PADDLE_MIN_Y = PADDLE_RADIUS;
const int PADDLE_MAX_Y = 31 - PADDLE_RADIUS;
const int OPENING_DELAY_DAA = 25;
const int SERVE_DELAY_DAA = 20;
// 150 DAA is fifteen nominal seconds at ten DAA/second, not wall-clock time.
const int RESPONSE_TIMEOUT_DAA = 150;
const int MAX_STAKE = 4611686018427387903;
state LobbyState { pubkey left; pubkey right; pubkey refund; int control_value; int ball_tick_daa; int stake_per_player; int ball_count; int win_score; }
state ContactState { int index; int side; int deadline; }
state PlayerState {
    pubkey owner; int side; int lane; byte[24] checkpoint;
    int t0; int t1; int t2; int t3; int d0; int d1; int d2; int d3;
    // Paddle checkpoint data is authoritative only in lane zero. All lanes use
    // the same lightweight Player template; verification code belongs to Court.
}
state CourtState {
    pubkey left; pubkey right; int stake_per_player;
    bool started; int clock; int ball_tick_daa;
    byte[120] balls;
    int ball_count; int win_score; int launch_epoch;
    byte[56] progress;
    // -1 binds new flight/progress freshness to this Court's actual acceptance.
    // Other replacements materialize and carry that DAA, never their own birth.
    int response_at;
}
state CollectionState { pubkey left; pubkey right; int stake_per_player; int win_score; int left_score; int right_score; int winner; int end_daa; }
state FinishedState { int stake_per_player; int win_score; int left_score; int right_score; int winner; int end_daa; }
fn clamp_paddle(int y) -> int {
    int result = y;
    if (result < PADDLE_MIN_Y) { result = PADDLE_MIN_Y; }
    if (result > PADDLE_MAX_Y) { result = PADDLE_MAX_Y; }
    return result;
}
fn serve_choice(int goal_daa, int total, pubkey left_key, pubkey right_key) -> int {
    byte[] seed = byte[]("PongServe/v3") + byte[](left_key) + byte[](right_key)
        + byte[](goal_daa as byte[8]) + byte[](total as byte[8]);
    byte[32] entropy = blake2b(seed);
    int choice = ((OpBin2Num(entropy.slice(0,2)) % 280) + 280) % 280;
    return choice;
}
fn contact_time(int at, int x, int vx, int serve, int tick) -> int {
    int distance = RIGHT_CONTACT_X - x;
    if (vx == -1) { distance = x - LEFT_CONTACT_X; }
    int ticks = (distance + 1) / 2;
    int phase = 0;
    if (at >= serve) { phase = (at - serve) % tick; }
    int start = at;
    if (start < serve) { start = serve; }
    return start + ticks * tick - phase;
}
fn launch_phase(int epoch, int index, int count, int tick) -> int {
    return epoch + (index * 27 * tick + count - 1) / count;
}
// Compact local flights avoid exhausting the VM's 244 live-binding limit.
// The committed Court schema remains five integers per ball.
fn pack_ball(int x, int y, int vx, int vy, int serve) -> byte[] {
    return byte[](x as byte[8])+byte[](y as byte[8])+byte[](vx as byte[8])+byte[](vy as byte[8])+byte[](serve as byte[8]);
}
fn serve_ball(int serve, int index, pubkey left_key, pubkey right_key) -> byte[] {
    int choice = serve_choice(serve,index,left_key,right_key);
    int vx = 1; if (choice%2 == 0) { vx = -1; }
    return pack_ball(CENTER_X,2+choice/10,vx,choice/2%5-2,serve);
}
fn packed_contact(byte[] b, int at, int tick) -> int {
    return contact_time(at,OpBin2Num(b.slice(0,8)),OpBin2Num(b.slice(16,24)),OpBin2Num(b.slice(32,40)),tick);
}
fn next_event(byte[] b0, byte[] b1, byte[] b2, int count, int at, int tick) -> ContactState {
    int index = 0; int vx = OpBin2Num(b0.slice(16,24));
    int deadline = packed_contact(b0,at,tick);
    if (count > 1) {
        int candidate = packed_contact(b1,at,tick);
        if (candidate < deadline) { index = 1; vx = OpBin2Num(b1.slice(16,24)); deadline = candidate; }
    }
    if (count > 2) {
        int candidate = packed_contact(b2,at,tick);
        if (candidate < deadline) { index = 2; vx = OpBin2Num(b2.slice(16,24)); deadline = candidate; }
    }
    int side = 1; if (vx == -1) { side = 0; }
    return ContactState { index:index, side:side, deadline:deadline };
}
fn move_ball(byte[] b, int at, int until, int tick) -> byte[] {
    int serve = OpBin2Num(b.slice(32,40));
    int vx = OpBin2Num(b.slice(16,24));
    int before = 0; if (at > serve) { before = (at-serve)/tick; }
    int after = 0; if (until > serve) { after = (until-serve)/tick; }
    int ticks = after-before;
    int x = OpBin2Num(b.slice(0,8))+vx*BALL_SPEED*ticks;
    if (x < LEFT_CONTACT_X) { x = LEFT_CONTACT_X; }
    if (x > RIGHT_CONTACT_X) { x = RIGHT_CONTACT_X; }
    int y = OpBin2Num(b.slice(8,16)); int vy = OpBin2Num(b.slice(24,32));
    if (ticks > 0 && vy != 0) {
        int speed = vy; if (speed < 0) { speed = -speed; }
        int phase = ((y+vy*ticks)%62+62)%62;
        y = phase; if (phase > 31) { y = 62-phase; vy = -vy; }
        if (phase == 0) { vy = -speed; }
        if (phase == 31) { vy = speed; }
    }
    return pack_ball(x,y,vx,vy,serve);
}
fn read_int(byte[] data, int offset) -> int {
    return OpBin2Num(data.slice(offset,offset+8));
}
fn queued_dir(byte[] prefix, int lane, int slot) -> int {
    int result = 0;
    if (read_int(prefix,120+lane*8) > slot) {
        int divisor = 1;
        if (slot == 1) { divisor = 64; }
        if (slot == 2) { divisor = 4096; }
        if (slot == 3) { divisor = 262144; }
        result = read_int(prefix,96+lane*8)/divisor%64-27;
    }
    return result;
}
actor Lobby owns LobbyState {
    entry start(sig right_sig) emits { court: Court, players: Player[6..=6], } {
        require(left != right && ball_tick_daa >= 1 && ball_tick_daa <= 64);
        require(ball_count >= 1 && ball_count <= 3 && win_score >= 1 && win_score <= 9);
        require(stake_per_player > 0 && stake_per_player <= MAX_STAKE);
        require(control_value > 0 && control_value % 3 == 0 && stake_per_player > control_value);
        require(self.value == stake_per_player);
        // Creation locks the host's chosen terms. The client independently
        // authenticates its player-signed creation manifest before joining.
        // No host ordinary coin is consumed by this transition.
        require(this.activeInputIndex == 0 && OpAuthOutputIdx(0,0) == 0);
        require(OpBin2Num(byte[](right_sig).slice(64,65)) == 1);
        require(checkSig(right_sig,right));
        require(court.value == 2 * stake_per_player - 2 * control_value);
        CourtState world = { left: left, right: right, stake_per_player: stake_per_player, started: false, clock: 0, ball_tick_daa: ball_tick_daa,
            balls:byte[120](pack_ball(CENTER_X,16,1,0,0)+pack_ball(CENTER_X,16,1,0,0)+pack_ball(CENTER_X,16,1,0,0)),
            ball_count:ball_count,win_score:win_score,launch_epoch:0,
            progress:byte[56](byte[](16 as byte[8])+byte[](16 as byte[8])+byte[](0 as byte[8])+byte[](0 as byte[8])+byte[](0 as byte[8])+byte[](0 as byte[8])+byte[](0 as byte[8])),response_at:-1 };
        PlayerState[] qs;
        for (i,0,6,6) {
            pubkey key = left;
            if (i % 2 == 1) { key = right; }
            PlayerState q = { owner:key, side:i%2, lane:i/2,
                checkpoint:byte[24](byte[](0 as byte[8])+byte[](16 as byte[8])+byte[](0 as byte[8])),
                t0:0,t1:0,t2:0,t3:0,d0:0,d1:0,d2:0,d3:0 };
            require(players[i].value == control_value/3); qs = qs.append(q);
        }
        become { court <- Court(world), players <- Player[](qs) };
    }
    entry cancel(sig refund_sig) emits none {
        require(checkSig(refund_sig,refund));
        require(tx.outputs.length >= 1);
        byte[36] destination = new ScriptPubKeyP2PK(refund);
        require(tx.outputs[0].scriptPubKey == byte[](destination));
        require(tx.outputs[0].value == self.value);
    }
}
actor Player owns PlayerState {
    entry command(int direction, sig owner_sig) emits next: Player {
        int count = OpBin2Num(checkpoint.slice(0,8));
        require(direction >= -27 && direction <= 27 && direction != 0);
        require(count >= 0 && count < 4);
        require(checkSig(owner_sig, owner));
        int accepted = OpTxInputDaaScore(this.activeInputIndex);
        require(accepted >= 0);
        int nt0 = t0; int nt1 = t1; int nt2 = t2; int nt3 = t3;
        if (count == 1 && t0 == -1) { nt0 = accepted; }
        if (count == 2 && t1 == -1) { nt1 = accepted; }
        if (count == 3 && t2 == -1) { nt2 = accepted; }
        if (count == 4 && t3 == -1) { nt3 = accepted; }
        int nd0 = d0; int nd1 = d1; int nd2 = d2; int nd3 = d3;
        if (count == 0) { nt0 = -1; nd0 = direction; }
        if (count == 1) { nt1 = -1; nd1 = direction; }
        if (count == 2) { nt2 = -1; nd2 = direction; }
        if (count == 3) { nt3 = -1; nd3 = direction; }
        PlayerState q = { owner: owner, side: side, lane: lane,
            checkpoint:byte[24](byte[]((count+1) as byte[8])+checkpoint.slice(8,24)),
            t0: nt0, t1: nt1, t2: nt2, t3: nt3, d0: nd0, d1: nd1, d2: nd2, d3: nd3 };
        require(next.value == self.value);
        become next <- Player(q);
    }
    delegate resolve() consumes { court: Court, } {}
    delegate collect() consumes { collector: Collector, } {}
}
actor Court owns CourtState {
    entry resolve(int side, int until, sig receiver_sig) consumes { paddle: Player, inputs: Player[2..=2], } emits {
        ball: Court, receiver: Player, players: Player[2..=2],
    } {
        require(paddle.lane == 0 && paddle.side == side && (side == 0 || side == 1));
        byte[] flight;
        byte[] prefix;
        {
        {
            pubkey expected = left; if (side == 1) { expected = right; }
            require(paddle.owner == expected && read_int(byte[](progress),16) < win_score && read_int(byte[](progress),24) < win_score);
            require(checkSig(receiver_sig,expected));
        }
        int at = clock; int epoch = launch_epoch;
        byte[] b0 = balls.slice(0,40);
        byte[] b1 = balls.slice(40,80);
        byte[] b2 = balls.slice(80,120);
        int born = OpTxInputDaaScore(this.activeInputIndex);
        require(born >= 0);
        if (!started) {
            at = born; epoch = born+OPENING_DELAY_DAA;
            b0 = serve_ball(epoch,0,left,right);
            if (ball_count > 1) { b1 = serve_ball(launch_phase(epoch,1,ball_count,ball_tick_daa),1,left,right); }
            if (ball_count > 2) { b2 = serve_ball(launch_phase(epoch,2,ball_count,ball_tick_daa),2,left,right); }
        }
        ContactState contact_event = next_event(b0,b1,b2,ball_count,at,ball_tick_daa);
        int deadline = contact_event.deadline;
        require(until >= read_int(byte[](paddle.checkpoint),16) && until <= deadline);
        // An absolute chain deadline expressed using the active input's age.
        if (until > born) { require(this.ageDaa >= until - born); }
        int fresh = response_at;
        require(fresh >= -1 && fresh <= born);
        if (fresh == -1) { fresh = born; }
        {
        int ny = read_int(byte[](paddle.checkpoint),8);
        int c0 = read_int(byte[](paddle.checkpoint),0);
        require(c0 >= 0 && c0 <= 4);
        byte[] times0;
        int dirs0 = (paddle.d0+27) + (paddle.d1+27)*64 + (paddle.d2+27)*4096 + (paddle.d3+27)*262144;
        {
            int accepted = OpTxInputDaaScore(OpCovInputIdx(self.cov_id,1));
            require(accepted >= 0);
            int a = paddle.t0; int b = paddle.t1; int c = paddle.t2; int d = paddle.t3;
            if (c0 == 1 && a == -1) { a = accepted; }
            if (c0 == 2 && b == -1) { b = accepted; }
            if (c0 == 3 && c == -1) { c = accepted; }
            if (c0 == 4 && d == -1) { d = accepted; }
            if (c0 > 0) { require(a >= read_int(byte[](paddle.checkpoint),16) && a <= accepted); }
            times0 = byte[](a as byte[8])+byte[](b as byte[8])+byte[](c as byte[8])+byte[](d as byte[8]);
        }
        require(inputs[0].owner == paddle.owner && inputs[0].side == side && inputs[0].lane == 1);
        int c1 = read_int(byte[](inputs[0].checkpoint),0);
        require(c1 >= 0 && c1 <= 4);
        byte[] times1;
        int dirs1 = (inputs[0].d0+27) + (inputs[0].d1+27)*64 + (inputs[0].d2+27)*4096 + (inputs[0].d3+27)*262144;
        {
            int accepted = OpTxInputDaaScore(OpCovInputIdx(self.cov_id,2));
            require(accepted >= 0);
            int a = inputs[0].t0; int b = inputs[0].t1; int c = inputs[0].t2; int d = inputs[0].t3;
            if (c1 == 1 && a == -1) { a = accepted; }
            if (c1 == 2 && b == -1) { b = accepted; }
            if (c1 == 3 && c == -1) { c = accepted; }
            if (c1 == 4 && d == -1) { d = accepted; }
            if (c1 > 0) { require(a >= read_int(byte[](paddle.checkpoint),16) && a <= accepted); }
            times1 = byte[](a as byte[8])+byte[](b as byte[8])+byte[](c as byte[8])+byte[](d as byte[8]);
        }
        require(inputs[1].owner == paddle.owner && inputs[1].side == side && inputs[1].lane == 2);
        int c2 = read_int(byte[](inputs[1].checkpoint),0);
        require(c2 >= 0 && c2 <= 4);
        byte[] times2;
        int dirs2 = (inputs[1].d0+27) + (inputs[1].d1+27)*64 + (inputs[1].d2+27)*4096 + (inputs[1].d3+27)*262144;
        {
            int accepted = OpTxInputDaaScore(OpCovInputIdx(self.cov_id,3));
            require(accepted >= 0);
            int a = inputs[1].t0; int b = inputs[1].t1; int c = inputs[1].t2; int d = inputs[1].t3;
            if (c2 == 1 && a == -1) { a = accepted; }
            if (c2 == 2 && b == -1) { b = accepted; }
            if (c2 == 3 && c == -1) { c = accepted; }
            if (c2 == 4 && d == -1) { d = accepted; }
            if (c2 > 0) { require(a >= read_int(byte[](paddle.checkpoint),16) && a <= accepted); }
            times2 = byte[](a as byte[8])+byte[](b as byte[8])+byte[](c as byte[8])+byte[](d as byte[8]);
        }
        // Four timestamp groups, retaining all remaining events for another
        // small checkpoint. Equal timestamps apply in paddle.lane order.
        for (event,0,4,4) {
            int head = until;
            if (c0 > 0) { int t = OpBin2Num(times0.slice(0,8)); if (t < head) { head = t; } }
            if (c1 > 0) { int t = OpBin2Num(times1.slice(0,8)); if (t < head) { head = t; } }
            if (c2 > 0) { int t = OpBin2Num(times2.slice(0,8)); if (t < head) { head = t; } }
            if (c0 > 0 && head < until && OpBin2Num(times0.slice(0,8)) == head) {
                ny = clamp_paddle(ny + dirs0%64-27);
                c0 = c0-1; times0 = times0.slice(8,32)+byte[](0 as byte[8]); dirs0 = dirs0/64;
            }
            if (c1 > 0 && head < until && OpBin2Num(times1.slice(0,8)) == head) {
                ny = clamp_paddle(ny + dirs1%64-27);
                c1 = c1-1; times1 = times1.slice(8,32)+byte[](0 as byte[8]); dirs1 = dirs1/64;
            }
            if (c2 > 0 && head < until && OpBin2Num(times2.slice(0,8)) == head) {
                ny = clamp_paddle(ny + dirs2%64-27);
                c2 = c2-1; times2 = times2.slice(8,32)+byte[](0 as byte[8]); dirs2 = dirs2/64;
            }
        }
        int watermark = until;
        if (c0 > 0) { int t = OpBin2Num(times0.slice(0,8)); if (t < watermark) { watermark = t; } }
        if (c1 > 0) { int t = OpBin2Num(times1.slice(0,8)); if (t < watermark) { watermark = t; } }
        if (c2 > 0) { int t = OpBin2Num(times2.slice(0,8)); if (t < watermark) { watermark = t; } }

        int target_side = contact_event.side;
        bool contact = side == target_side && until == deadline && watermark == deadline;
        // Empty Court replacements must not invalidate timeout claims forever.
        require(contact || watermark > read_int(byte[](paddle.checkpoint),16) || c0+c1+c2 < read_int(byte[](paddle.checkpoint),0)+read_int(byte[](inputs[0].checkpoint),0)+read_int(byte[](inputs[1].checkpoint),0));
        // Only consumed receiver history strictly before contact can renew.
        // After contact is due there are at most 3*4 such queued batches;
        // later commands cannot replenish them, so renewals remain bounded.
        if (side == target_side && c0+c1+c2 < read_int(byte[](paddle.checkpoint),0)+read_int(byte[](inputs[0].checkpoint),0)+read_int(byte[](inputs[1].checkpoint),0)) { fresh = -1; }
        prefix = times0+times1+times2+byte[](dirs0 as byte[8])+byte[](dirs1 as byte[8])+byte[](dirs2 as byte[8])
            +byte[](c0 as byte[8])+byte[](c1 as byte[8])+byte[](c2 as byte[8])+byte[](ny as byte[8])+byte[](watermark as byte[8]);
        }
        int ny = read_int(prefix,144);
        bool contact = side == contact_event.side && until == deadline && read_int(prefix,152) == deadline;
        int ls = read_int(byte[](progress),16); int rs = read_int(byte[](progress),24);
        int ly = read_int(byte[](progress),0); int ry = read_int(byte[](progress),8);
        int next_resolver = read_int(byte[](progress),32); int next_resolves = read_int(byte[](progress),40);
        if (contact) {
            b0 = move_ball(b0,at,deadline,ball_tick_daa);
            if (ball_count > 1) { b1 = move_ball(b1,at,deadline,ball_tick_daa); }
            if (ball_count > 2) { b2 = move_ball(b2,at,deadline,ball_tick_daa); }
            byte[] hit = b0;
            if (contact_event.index == 1) { hit = b1; }
            if (contact_event.index == 2) { hit = b2; }
            int offset = OpBin2Num(hit.slice(8,16))-ny;
            if (offset < -(PADDLE_RADIUS+BALL_RADIUS) || offset > PADDLE_RADIUS+BALL_RADIUS) {
                if (side == 1) { ls = ls+1; } else { rs = rs+1; }
                int phase = launch_phase(epoch,contact_event.index,ball_count,ball_tick_daa);
                int period = 27*ball_tick_daa;
                int cycles = (deadline+SERVE_DELAY_DAA-phase+period-1)/period;
                hit = serve_ball(phase+cycles*period,contact_event.index,left,right);
            } else {
                int vy = offset; if (vy < -2) { vy = -2; } if (vy > 2) { vy = 2; }
                hit = hit.slice(0,16)+byte[]((-OpBin2Num(hit.slice(16,24))) as byte[8])+byte[](vy as byte[8])+hit.slice(32,40);
            }
            if (contact_event.index == 0) { b0 = hit; }
            if (contact_event.index == 1) { b1 = hit; }
            if (contact_event.index == 2) { b2 = hit; }
            if (side == 0) { ly = ny; } else { ry = ny; }
            at = deadline; fresh = -1; next_resolver = 1-side; next_resolves = next_resolves+1;
        }
        flight = b0+b1+b2+byte[](at as byte[8])+byte[](epoch as byte[8])
            +byte[](ly as byte[8])+byte[](ry as byte[8])+byte[](ls as byte[8])+byte[](rs as byte[8])
            +byte[](next_resolver as byte[8])+byte[](next_resolves as byte[8])+byte[](fresh as byte[8]);
        }
        // Release folding/flight scratch bindings before constructing successors.
        PlayerState[] queues;
        {
        PlayerState q = { owner:paddle.owner,side:side,lane:1,
            checkpoint:byte[24](prefix.slice(128,136)+byte[](16 as byte[8])+byte[](0 as byte[8])),
            t0:read_int(prefix,32),t1:read_int(prefix,40),t2:read_int(prefix,48),t3:read_int(prefix,56),
            d0:queued_dir(prefix,1,0),d1:queued_dir(prefix,1,1),d2:queued_dir(prefix,1,2),d3:queued_dir(prefix,1,3),
            };
        queues = queues.append(q);
        }
        {
        PlayerState q = { owner:paddle.owner,side:side,lane:2,
            checkpoint:byte[24](prefix.slice(136,144)+byte[](16 as byte[8])+byte[](0 as byte[8])),
            t0:read_int(prefix,64),t1:read_int(prefix,72),t2:read_int(prefix,80),t3:read_int(prefix,88),
            d0:queued_dir(prefix,2,0),d1:queued_dir(prefix,2,1),d2:queued_dir(prefix,2,2),d3:queued_dir(prefix,2,3),
            };
        queues = queues.append(q);
        }
        require(ball.value == self.value && receiver.value == paddle.value);
        require(players[0].value == inputs[0].value && players[1].value == inputs[1].value);
        become { ball <- Court(CourtState { left:left,right:right,stake_per_player:stake_per_player,started:true,clock:read_int(flight,120),ball_tick_daa:ball_tick_daa,
            balls:byte[120](flight.slice(0,120)),
            ball_count:ball_count,win_score:win_score,launch_epoch:read_int(flight,128),
            progress:byte[56](flight.slice(136,184)+progress.slice(48,56)),response_at:read_int(flight,184) }),
            receiver <- Player(PlayerState { owner:paddle.owner,side:side,lane:0,
                checkpoint:byte[24](prefix.slice(120,128)+prefix.slice(144,160)),
                t0:read_int(prefix,0),t1:read_int(prefix,8),t2:read_int(prefix,16),t3:read_int(prefix,24),
                d0:queued_dir(prefix,0,0),d1:queued_dir(prefix,0,1),d2:queued_dir(prefix,0,2),d3:queued_dir(prefix,0,3),
                }), players <- Player[](queues) };
    }
    // Only authorize leaving live play here; collection code lives elsewhere.
    entry timeout(sig winner_sig) emits next: Collector {
        int left_score = read_int(byte[](progress),16); int right_score = read_int(byte[](progress),24);
        require(left_score < win_score && right_score < win_score);
        int at = clock;
        byte[] b0 = balls.slice(0,40);
        byte[] b1 = balls.slice(40,80);
        byte[] b2 = balls.slice(80,120);
        int born = OpTxInputDaaScore(this.activeInputIndex);
        require(born >= 0);
        if (!started) {
            at = born;
            int epoch = born+OPENING_DELAY_DAA;
            b0 = serve_ball(epoch,0,left,right);
            if (ball_count > 1) { b1 = serve_ball(launch_phase(epoch,1,ball_count,ball_tick_daa),1,left,right); }
            if (ball_count > 2) { b2 = serve_ball(launch_phase(epoch,2,ball_count,ball_tick_daa),2,left,right); }
        }
        ContactState event = next_event(b0,b1,b2,ball_count,at,ball_tick_daa);
        int fresh = response_at;
        require(fresh >= -1 && fresh <= born);
        if (fresh == -1) { fresh = born; }
        int anchor = event.deadline;
        if (fresh > anchor) { anchor = fresh; }
        int expiry = anchor+RESPONSE_TIMEOUT_DAA;
        // ageDaa is the declared sequence lower bound. Consensus supplies the
        // minimum spend age; it cannot forbid a late signed response.
        if (expiry > born) { require(this.ageDaa >= expiry-born); }
        int winner = 0; pubkey key = left;
        if (event.side == 0) { winner = 1; key = right; }
        require(checkSig(winner_sig,key));
        CollectionState result = { left:left, right:right, stake_per_player:stake_per_player,win_score:win_score, left_score:left_score, right_score:right_score, winner:winner, end_daa:expiry };
        require(next.value == self.value);
        become next <- Collector(result);
    }
    entry settle() emits next: Collector {
        int left_score = read_int(byte[](progress),16); int right_score = read_int(byte[](progress),24);
        require(left_score == win_score || right_score == win_score);
        int winner = 0; if (right_score == win_score) { winner = 1; }
        CollectionState result = { left:left, right:right, stake_per_player:stake_per_player,win_score:win_score, left_score:left_score, right_score:right_score, winner:winner, end_daa:clock };
        require(next.value == self.value);
        become next <- Collector(result);
    }
}
actor Collector owns CollectionState {
    entry collect() consumes { inputs: Player[6..=6], } emits none {
        require(stake_per_player > 0 && stake_per_player <= MAX_STAKE);
        require(winner >= 0 && winner <= 1);
        int total = self.value;
        for (i,0,6,6) {
            pubkey key = left; if (i%2 == 1) { key = right; }
            require(inputs[i].owner == key && inputs[i].side == i%2 && inputs[i].lane == i/2);
            total = total+inputs[i].value;
        }
        int pot = 2 * stake_per_player;
        require(total == pot && tx.outputs.length >= 1);
        pubkey pay = left; if (winner == 1) { pay = right; }
        byte[36] payout = new ScriptPubKeyP2PK(pay);
        require(tx.outputs[0].scriptPubKey == byte[](payout));
        require(tx.outputs[0].value == pot);
    }
}
app Pong { actor Lobby; actor Player; actor Court; actor Collector; }
