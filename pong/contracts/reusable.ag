        require((q0.role%3) == 0 && (q1.role%3) == 1 && (q2.role%3) == 2);
        require(q0.game == self.cov_id && q1.game == self.cov_id && q2.game == self.cov_id);
        require(read_int(byte[](q0.data),0) == read_int(byte[](generations),0) && read_int(byte[](q1.data),0) == read_int(byte[](generations),0) && read_int(byte[](q2.data),0) == read_int(byte[](generations),0));
        require(read_int(byte[](q0.data),24) == 1);
        require(tx.outputs[OpCovOutputIdx(left_pool,0)].value == part(left_balance,0));
        require(read_int(byte[](q1.data),24) == 1);
        require(tx.outputs[OpCovOutputIdx(left_pool,1)].value == part(left_balance,1));
        require(read_int(byte[](q2.data),24) == 1);
        require(tx.outputs[OpCovOutputIdx(left_pool,2)].value == part(left_balance,2));
        require(read_int(byte[](q0.data),16)+read_int(byte[](q1.data),16)+read_int(byte[](q2.data),16) == exposure);
        require lp.outputs become {left0 <- Bank(PlayerState {owner:q0.owner,game:self.cov_id,data:byte[120](byte[]((read_int(byte[](generations),0)+1) as byte[8])+q0.data.slice(8,16)+byte[]((0) as byte[8])+zero16()+byte[](16 as byte[8])+zero72()),role:(0)*3+((q0.role%3))}),left1 <- Lane(PlayerState {owner:q1.owner,game:self.cov_id,data:byte[120](byte[]((read_int(byte[](generations),0)+1) as byte[8])+q1.data.slice(8,16)+byte[]((0) as byte[8])+zero16()+byte[](16 as byte[8])+zero72()),role:(0)*3+((q1.role%3))}),left2 <- Lane(PlayerState {owner:q2.owner,game:self.cov_id,data:byte[120](byte[]((read_int(byte[](generations),0)+1) as byte[8])+q2.data.slice(8,16)+byte[]((0) as byte[8])+zero16()+byte[](16 as byte[8])+zero72()),role:(0)*3+((q2.role%3))}),};
        }
        {
        PlayerState q0=state(rp.inputs.right0);
        PlayerState q1=state(rp.inputs.right1);
        PlayerState q2=state(rp.inputs.right2);
        require(q0.owner == right && q1.owner == right && q2.owner == right);
        require((q0.role%3) == 0 && (q1.role%3) == 1 && (q2.role%3) == 2);
        require(q0.game == self.cov_id && q1.game == self.cov_id && q2.game == self.cov_id);
        require(read_int(byte[](q0.data),0) == read_int(byte[](generations),8) && read_int(byte[](q1.data),0) == read_int(byte[](generations),8) && read_int(byte[](q2.data),0) == read_int(byte[](generations),8));
        require(read_int(byte[](q0.data),24) == 1);
        require(tx.outputs[OpCovOutputIdx(right_pool,0)].value == part(right_balance,0));
        require(read_int(byte[](q1.data),24) == 1);
        require(tx.outputs[OpCovOutputIdx(right_pool,1)].value == part(right_balance,1));
        require(read_int(byte[](q2.data),24) == 1);
        require(tx.outputs[OpCovOutputIdx(right_pool,2)].value == part(right_balance,2));
        require(read_int(byte[](q0.data),16)+read_int(byte[](q1.data),16)+read_int(byte[](q2.data),16) == exposure);
        require rp.outputs become {right0 <- Bank(PlayerState {owner:q0.owner,game:self.cov_id,data:byte[120](byte[]((read_int(byte[](generations),8)+1) as byte[8])+q0.data.slice(8,16)+byte[]((0) as byte[8])+zero16()+byte[](16 as byte[8])+zero72()),role:(1)*3+((q0.role%3))}),right1 <- Lane(PlayerState {owner:q1.owner,game:self.cov_id,data:byte[120](byte[]((read_int(byte[](generations),8)+1) as byte[8])+q1.data.slice(8,16)+byte[]((0) as byte[8])+zero16()+byte[](16 as byte[8])+zero72()),role:(1)*3+((q1.role%3))}),right2 <- Lane(PlayerState {owner:q2.owner,game:self.cov_id,data:byte[120](byte[]((read_int(byte[](generations),8)+1) as byte[8])+q2.data.slice(8,16)+byte[]((0) as byte[8])+zero16()+byte[](16 as byte[8])+zero72()),role:(1)*3+((q2.role%3))}),};
        }

    }
}
app ReusablePong { actor Bank; actor Lane; actor Lobby; actor Court; actor Collector; }
