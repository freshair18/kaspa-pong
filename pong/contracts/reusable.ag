actor Collector owns CollectionState {
    entry collect()
    observes lp by self.left_pool { inputs { left0:Lane, left1:Lane, left2:Lane, } outputs { left0:Bank, left1:Lane, left2:Lane, } }
    observes rp by self.right_pool { inputs { right0:Lane, right1:Lane, right2:Lane, } outputs { right0:Bank, right1:Lane, right2:Lane, } }
    emits none {
        require(winner >= 0 && winner <= 1 && self.value == 2*(stake_per_player/2));
        int exposure=stake_per_player-stake_per_player/2;
        int left_balance=tx.inputs[OpCovInputIdx(left_pool,0)].value+tx.inputs[OpCovInputIdx(left_pool,1)].value+tx.inputs[OpCovInputIdx(left_pool,2)].value;
        int right_balance=tx.inputs[OpCovInputIdx(right_pool,0)].value+tx.inputs[OpCovInputIdx(right_pool,1)].value+tx.inputs[OpCovInputIdx(right_pool,2)].value;
        if (winner == 0) {left_balance=left_balance+self.value+exposure;right_balance=right_balance-exposure;}
        else {right_balance=right_balance+self.value+exposure;left_balance=left_balance-exposure;}
        {
