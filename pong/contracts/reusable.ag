// Persistent player queue sets with atomic cross-covenant game binding.
// Contact-based Pong using Argent's coordinated leader/delegate flow.
// All movement actors remain small. Court authenticates only one side's three
// queues, folds its movement prefix and resolves contact in the same transaction.
// Relative DAA locks bind the boundary to chain time. Movements at or after the
// contact DAA remain queued and cannot retroactively change a hit or miss.
const int COURT_WIDTH = 58;
const int LEFT_CONTACT_X = 2;
const int RIGHT_CONTACT_X = COURT_WIDTH - 3;
const int CENTER_X = COURT_WIDTH / 2;
const int BALL_SPEED = 2;
const int PADDLE_RADIUS = 4;
const int BALL_RADIUS = 1;
const int PADDLE_MIN_Y = PADDLE_RADIUS;
const int PADDLE_MAX_Y = 31 - PADDLE_RADIUS;
const int OPENING_DELAY_DAA = 25;
const int SERVE_DELAY_DAA = 20;
// At ten DAA per second, 110 DAA is about eleven seconds of chain time.
const int RESPONSE_TIMEOUT_DAA = 110;
const int MAX_STAKE = 4611686018427387903;
state LobbyState { cov_id left_pool; cov_id right_pool; byte[16] generations; pubkey left; pubkey right; byte[32] terms; }
state ContactState { int index; int side; int deadline; }
state PlayerState { cov_id game; byte[120] data;
    pubkey owner; int role; 
    
    // Paddle checkpoint data is authoritative only in lane zero. All lanes use
    // the same lightweight Lane template; verification code belongs to Court.
}
state CourtState { cov_id left_pool; cov_id right_pool; byte[16] generations;
    pubkey left; pubkey right; byte[64] header; byte[448] flights; byte[56] progress;
}
state CollectionState { cov_id left_pool; cov_id right_pool; byte[16] generations; pubkey left; pubkey right; int stake_per_player; int win_score; int left_score; int right_score; int winner; int end_daa; }
state FinishedState { int stake_per_player; int win_score; int left_score; int right_score; int winner; int end_daa; }
fn clamp_paddle(int y) -> int {
    int result = y;
    if (result < PADDLE_MIN_Y) { result = PADDLE_MIN_Y; }
    if (result > PADDLE_MAX_Y) { result = PADDLE_MAX_Y; }
    return result;
}
fn serve_choice(int goal_daa, int total, pubkey left_key, pubkey right_key) -> int {
    byte[] seed = byte[]("PongServe/v3") + byte[](left_key) + byte[](right_key)
        + byte[](goal_daa as byte[8]) + byte[](total as byte[8]);
    byte[32] entropy = blake2b(seed);
    int choice = ((OpBin2Num(entropy.slice(0,2)) % 280) + 280) % 280;
    return choice;
}
fn contact_time(int at, int x, int vx, int serve, int tick) -> int {
    int distance = RIGHT_CONTACT_X - x;
    if (vx == -1) { distance = x - LEFT_CONTACT_X; }
    int ticks = (distance + 1) / 2;
    int phase = 0;
    if (at >= serve) { phase = (at - serve) % tick; }
    int start = at;
    if (start < serve) { start = serve; }
    return start + ticks * tick - phase;
}
fn launch_phase(int epoch, int index, int count, int tick) -> int {
    return epoch + (index * 27 * tick + count - 1) / count;
}
fn pack_ball(int x, int y, int vx, int vy, int serve) -> byte[] {
    return byte[](x as byte[8])+byte[](y as byte[8])+byte[](vx as byte[8])+byte[](vy as byte[8])+byte[](serve as byte[8]);
}
fn serve_ball(int serve, int index, pubkey left_key, pubkey right_key) -> byte[] {
    int choice = serve_choice(serve,index,left_key,right_key);
    int vx = 1; if (choice%2 == 0) { vx = -1; }
    return pack_ball(CENTER_X,2+choice/10,vx,choice/2%5-2,serve);
}
fn packed_contact(byte[] b, int at, int tick) -> int {
    return contact_time(at,OpBin2Num(b.slice(0,8)),OpBin2Num(b.slice(16,24)),OpBin2Num(b.slice(32,40)),tick);
}
// Each 56-byte slot holds the next contact DAA, the flight origin DAA, and
// the five ball words. A zero deadline denotes an untouched opening flight.
fn next_event(byte[] flights, int count, int epoch, int tick, pubkey left_key, pubkey right_key) -> ContactState {
    int index = count;
    int deadline = 0;
    int untouched = count;
    for (i,0,8,8) {
        if (i < count) {
            int candidate = read_int(flights,i*56);
            if (candidate == 0) {
                if (untouched == count) { untouched = i; }
            } else if (deadline == 0 || candidate < deadline) {
                index = i; deadline = candidate;
            }
        }
    }
    int side = 1;
    if (deadline > 0) {
        if (read_int(flights,index*56+32) == -1) { side = 0; }
    }
    if (untouched < count) {
        // Opening slots are at least three ticks apart at eight balls. Their
        // flight lengths differ by at most one tick, so only the first unused
        // launch can be the next contact.
        int serve = launch_phase(epoch,untouched,count,tick);
        int choice = serve_choice(serve,untouched,left_key,right_key);
        int opening_side = 1;
        int steps = 13;
        if (choice%2 == 0) { opening_side = 0; steps = 14; }
        int candidate = serve+steps*tick;
        if (deadline == 0 || candidate < deadline || (candidate == deadline && untouched < index)) {
            index = untouched; side = opening_side; deadline = candidate;
        }
    }
    return ContactState { index:index, side:side, deadline:deadline };
}
fn move_ball(byte[] b, int at, int until, int tick) -> byte[] {
    int serve = OpBin2Num(b.slice(32,40));
    int vx = OpBin2Num(b.slice(16,24));
    int before = 0; if (at > serve) { before = (at-serve)/tick; }
    int after = 0; if (until > serve) { after = (until-serve)/tick; }
    int ticks = after-before;
    int x = OpBin2Num(b.slice(0,8))+vx*BALL_SPEED*ticks;
    if (x < LEFT_CONTACT_X) { x = LEFT_CONTACT_X; }
    if (x > RIGHT_CONTACT_X) { x = RIGHT_CONTACT_X; }
    int y = OpBin2Num(b.slice(8,16)); int vy = OpBin2Num(b.slice(24,32));
    if (ticks > 0 && vy != 0) {
        int speed = vy; if (speed < 0) { speed = -speed; }
        int phase = ((y+vy*ticks)%62+62)%62;
        y = phase; if (phase > 31) { y = 62-phase; vy = -vy; }
        if (phase == 0) { vy = -speed; }
        if (phase == 31) { vy = speed; }
    }
    return pack_ball(x,y,vx,vy,serve);
}
// The VM limits each numeric conversion to eight bytes.
fn zero16() -> byte[] {
    byte[] word = OpNum2Bin(0,8);
    return word+word;
}
fn zero72() -> byte[] {
    byte[] two = zero16();
    byte[] four = two+two;
    return four+four+OpNum2Bin(0,8);
}
fn read_int(byte[] data, int offset) -> int {
    return OpBin2Num(data.slice(offset,offset+8));
}
fn queued_dir(byte[] prefix, int lane, int slot) -> int {
    int result = 0;
    if (read_int(prefix,120+lane*8) > slot) {
        int divisor = 1;
        if (slot == 1) { divisor = 64; }
        if (slot == 2) { divisor = 4096; }
        if (slot == 3) { divisor = 262144; }
        result = read_int(prefix,96+lane*8)/divisor%64-27;
    }
    return result;
}

const int MIN_POOL_RESERVE = 200000000;
fn part(int total, int lane) -> int {
    int extra = 0; if (lane < total % 3) { extra = 1; }
    return total/3+extra;
}
// Match the wallet's historical worst-loss reserve for whole-KAS wagers.
fn fee_reserve_floor(int wager, int lane, int reserve) -> int {
    int minimum = 250000000;
    if (wager < 2900000000) { minimum = 275000000; }
    if (wager < 900000000) { minimum = 300000000; }
    int share = part(minimum,lane);
    if (reserve > share) { share = reserve; }
    return share;
}
actor Bank owns PlayerState {
    entry accept(sig owner_sig, cov_id game_id, int assigned_side, int exposure)
    consumes { others: Lane[2..=2], }
    emits { primary: Lane, queues: Lane[2..=2], } {
        require((role%3) == 0 && !(read_int(byte[](data),24) == 1) && game_id.co_spent());
        require(checkSig(owner_sig,owner) && assigned_side == 1 && exposure > 0);
        require(others[0].owner == owner && others[1].owner == owner);
        require((others[0].role%3) == 1 && (others[1].role%3) == 2);
        require(!(read_int(byte[](others[0].data),24) == 1) && !(read_int(byte[](others[1].data),24) == 1));
        require((read_int(byte[](others[0].data),0)) == (read_int(byte[](data),0)) && (read_int(byte[](others[1].data),0)) == (read_int(byte[](data),0)));
        require((read_int(byte[](data),8))+(read_int(byte[](others[0].data),8))+(read_int(byte[](others[1].data),8)) >= MIN_POOL_RESERVE);
        PlayerState[] next;
        next = next.append(PlayerState {owner:owner,game:game_id,data:byte[120](data.slice(0,8)+data.slice(8,16)+byte[]((part(exposure,0)) as byte[8])+byte[](1 as byte[8])+byte[](0 as byte[8])+byte[](16 as byte[8])+zero72()),role:(assigned_side)*3+0});
        next = next.append(PlayerState {owner:others[0].owner,game:game_id,data:byte[120](data.slice(0,8)+others[0].data.slice(8,16)+byte[]((part(exposure,1)) as byte[8])+byte[](1 as byte[8])+byte[](0 as byte[8])+byte[](16 as byte[8])+zero72()),role:(assigned_side)*3+((others[0].role%3))});
        next = next.append(PlayerState {owner:others[1].owner,game:game_id,data:byte[120](data.slice(0,8)+others[1].data.slice(8,16)+byte[]((part(exposure,2)) as byte[8])+byte[](1 as byte[8])+byte[](0 as byte[8])+byte[](16 as byte[8])+zero72()),role:(assigned_side)*3+((others[1].role%3))});
        for (i,0,2,2) { require(queues[i].value >= fee_reserve_floor(exposure*2,i+1,read_int(byte[](others[i].data),8))+part(exposure,i+1)); }
        require(primary.value >= fee_reserve_floor(exposure*2,0,read_int(byte[](data),8))+part(exposure,0));
        PlayerState[] tail;tail=tail.append(next[1]);tail=tail.append(next[2]);
        become { primary <- Lane(next[0]), queues <- Lane[](tail), };
    }
    entry reserve_game(sig owner_sig, LobbyState offer)
    consumes { others: Lane[2..=2], }
    spawns match_game by match_id { outputs { lobby: Lobby, } }
    emits { primary: Lane, queues: Lane[2..=2], } {
        require((role%3) == 0 && !(read_int(byte[](data),24) == 1) && checkSig(owner_sig,owner));
        require(offer.left == owner && offer.left_pool == self.cov_id && read_int(byte[](offer.generations),0) == (read_int(byte[](data),0)));
        require(offer.left != offer.right && offer.left_pool != offer.right_pool);
        require(read_int(byte[](offer.terms),8) >= 500000000 && read_int(byte[](offer.terms),8) <= 25400000000);
        require(others[0].owner == owner && others[1].owner == owner);
        require((others[0].role%3) == 1 && (others[1].role%3) == 2 && !(read_int(byte[](others[0].data),24) == 1) && !(read_int(byte[](others[1].data),24) == 1));
        require((read_int(byte[](others[0].data),0)) == (read_int(byte[](data),0)) && (read_int(byte[](others[1].data),0)) == (read_int(byte[](data),0)));
        require((read_int(byte[](data),8))+(read_int(byte[](others[0].data),8))+(read_int(byte[](others[1].data),8)) >= MIN_POOL_RESERVE);
        require(match_game.outputs.lobby.value == read_int(byte[](offer.terms),8)/2);
        require match_game.outputs become { lobby <- Lobby(offer), };
        int exposure = read_int(byte[](offer.terms),8)-read_int(byte[](offer.terms),8)/2;
        PlayerState[] next;
        next = next.append(PlayerState {owner:owner,game:match_id,data:byte[120](data.slice(0,8)+data.slice(8,16)+byte[]((part(exposure,0)) as byte[8])+byte[](1 as byte[8])+byte[](0 as byte[8])+byte[](16 as byte[8])+zero72()),role:(0)*3+0});
        next = next.append(PlayerState {owner:others[0].owner,game:match_id,data:byte[120](data.slice(0,8)+others[0].data.slice(8,16)+byte[]((part(exposure,1)) as byte[8])+byte[](1 as byte[8])+byte[](0 as byte[8])+byte[](16 as byte[8])+zero72()),role:(0)*3+((others[0].role%3))});
        next = next.append(PlayerState {owner:others[1].owner,game:match_id,data:byte[120](data.slice(0,8)+others[1].data.slice(8,16)+byte[]((part(exposure,2)) as byte[8])+byte[](1 as byte[8])+byte[](0 as byte[8])+byte[](16 as byte[8])+zero72()),role:(0)*3+((others[1].role%3))});
        int wager = read_int(byte[](offer.terms),8);
        for (i,0,2,2) { require(queues[i].value >= fee_reserve_floor(wager,i+1,read_int(byte[](others[i].data),8))+part(exposure,i+1)); }
        require(primary.value >= fee_reserve_floor(wager,0,read_int(byte[](data),8))+part(exposure,0));
        PlayerState[] tail;tail=tail.append(next[1]);tail=tail.append(next[2]);
        become { primary <- Lane(next[0]), queues <- Lane[](tail), };
    }
    entry close(sig owner_sig, int fee)
    consumes { others: Lane[2..=2], } emits none {
        require((role%3) == 0 && !(read_int(byte[](data),24) == 1) && checkSig(owner_sig,owner));
        require(others[0].owner == owner && others[1].owner == owner);
        require((others[0].role%3) == 1 && (others[1].role%3) == 2 && !(read_int(byte[](others[0].data),24) == 1) && !(read_int(byte[](others[1].data),24) == 1));
        require((read_int(byte[](others[0].data),0)) == (read_int(byte[](data),0)) && (read_int(byte[](others[1].data),0)) == (read_int(byte[](data),0)));
        require(fee >= 0 && tx.outputs.length >= 1);
        require(tx.outputs[0].scriptPubKey == byte[](new ScriptPubKeyP2PK(owner)));
        require(tx.outputs[0].value >= self.value+others[0].value+others[1].value-fee);
    }
    entry resize(sig owner_sig) consumes { others:Lane[2..=2], } emits { primary:Bank, queues:Lane[2..=2], } {
        require((role%3) == 0 && read_int(byte[](data),24) == 0 && checkSig(owner_sig,owner));
        require(others[0].owner == owner && others[1].owner == owner && (others[0].role%3) == 1 && (others[1].role%3) == 2);
        require(read_int(byte[](others[0].data),24) == 0 && read_int(byte[](others[1].data),24) == 0);
        require(read_int(byte[](others[0].data),0) == read_int(byte[](data),0) && read_int(byte[](others[1].data),0) == read_int(byte[](data),0));
        require(primary.value >= read_int(byte[](data),8) && queues[0].value >= read_int(byte[](others[0].data),8) && queues[1].value >= read_int(byte[](others[1].data),8));
        PlayerState[] next;
        next=next.append(PlayerState{game:game,data:data,owner:owner,role:((role/3))*3+((role%3))});
        next=next.append(state(others[0]));next=next.append(state(others[1]));
        require(primary.value >= read_int(byte[](next[0].data),8)+read_int(byte[](next[0].data),16));
        PlayerState[] tail;tail=tail.append(next[1]);tail=tail.append(next[2]);
        become { primary <- Bank(next[0]), queues <- Lane[](tail), };
    }
}
fn require_coordinator(cov_id game_id, cov_id pool, int input_index, int role, byte[120] data) -> bool {
    require(read_int(byte[](data),24) == 1 && game_id != pool);
    require(OpCovInputCount(game_id) == 1);
    require(OpCovInputCount(pool) == 3 && OpCovOutputCount(pool) == 3);
    int lane = role%3;
    require(lane >= 0 && lane < 3);
    require(OpCovInputIdx(pool,lane) == input_index);
    return OpCovOutputIdx(pool,lane) == OpAuthOutputIdx(input_index,0);
}
actor Lane owns PlayerState {
    entry supply(sig owner_sig) emits none {
        require(!(read_int(byte[](data),24) == 1) && (role%3) > 0 && checkSig(owner_sig,owner));
    }
    // The matching game input checks the complete transition. Each lane
    // authorizes only the replacement at its own position in the set.
    entry coordinate(PlayerState successor) emits next: Lane {
        require(require_coordinator(game, self.cov_id, this.activeInputIndex, role, data));
        require(next.value >= read_int(byte[](data),8));
        become next <- Lane(successor);
    }
    entry reset_primary(PlayerState successor) emits next: Bank {
        require(require_coordinator(game, self.cov_id, this.activeInputIndex, role, data));
        require(OpCovOutputCount(game) == 0 && role%3 == 0);
        require(next.value >= read_int(byte[](data),8));
        become next <- Bank(successor);
    }
    entry command(int direction, sig owner_sig) emits next: Lane {
        int count = OpBin2Num(data.slice(32,56).slice(0,8));
        require((read_int(byte[](data),24) == 1));
        require(direction >= -27 && direction <= 27 && direction != 0);
        require(count >= 0 && count < 4);
        require(checkSig(owner_sig, owner));
        int nt0 = read_int(byte[](data.slice(56,120)),0); int nt1 = read_int(byte[](data.slice(56,120)),8); int nt2 = read_int(byte[](data.slice(56,120)),16); int nt3 = read_int(byte[](data.slice(56,120)),24);
        // Only a data.slice(56,120) movement needs its parent's actual acceptance time.
        if ((count == 1 && read_int(byte[](data.slice(56,120)),0) == -1) || (count == 2 && read_int(byte[](data.slice(56,120)),8) == -1)
            || (count == 3 && read_int(byte[](data.slice(56,120)),16) == -1)) {
            int accepted = OpTxInputDaaScore(this.activeInputIndex);
            require(accepted >= 0);
            if (count == 1) { nt0 = accepted; }
            if (count == 2) { nt1 = accepted; }
            if (count == 3) { nt2 = accepted; }
        }
        int nd0 = read_int(byte[](data.slice(56,120)),32); int nd1 = read_int(byte[](data.slice(56,120)),40); int nd2 = read_int(byte[](data.slice(56,120)),48); int nd3 = read_int(byte[](data.slice(56,120)),56);
        if (count == 0) { nt0 = -1; nd0 = direction; }
        if (count == 1) { nt1 = -1; nd1 = direction; }
        if (count == 2) { nt2 = -1; nd2 = direction; }
        if (count == 3) { nt3 = -1; nd3 = direction; }
        PlayerState q = {owner:owner,game:game,data:byte[120](byte[](data.slice(0,32))+byte[](byte[24](byte[]((count+1) as byte[8])+data.slice(32,56).slice(8,24)))+byte[](byte[64](byte[](nt0 as byte[8])+byte[](nt1 as byte[8])+byte[](nt2 as byte[8])+byte[](nt3 as byte[8])+byte[](nd0 as byte[8])+byte[](nd1 as byte[8])+byte[](nd2 as byte[8])+byte[](nd3 as byte[8])))),role:((role/3))*3+((role%3))};
        int exposure = read_int(byte[](data),16);
        // A lane holds a rounded third of half the wager. Recover its whole-KAS amount.
        int wager = (exposure*6+50000000)/100000000*100000000;
        require(next.value >= fee_reserve_floor(wager,role%3,read_int(byte[](data),8))+exposure);
        become next <- Lane(q);
    }
}

actor Lobby owns LobbyState {
    entry start(sig right_sig, cov_id chosen_pool, int chosen_generation)
    observes rp by chosen_pool {
        inputs { right0: Bank, right1:Lane, right2:Lane, }
        outputs { right0: Lane, right1:Lane, right2:Lane, }
    }
    emits court: Court {
        require(left != right && left_pool != chosen_pool);
        require(OpCovInputCount(left_pool) == 0 && OpCovOutputCount(left_pool) == 0);
        require(byte[](right_pool) == byte[](right) || (right_pool == chosen_pool && read_int(byte[](generations),8) == chosen_generation));
        require(chosen_generation >= 0);
        require(read_int(byte[](terms),0) >= 1 && read_int(byte[](terms),0) <= 15 && read_int(byte[](terms),16) >= 1 && read_int(byte[](terms),16) <= 8 && read_int(byte[](terms),24) >= 1 && read_int(byte[](terms),24) <= 15);
        require(read_int(byte[](terms),8) >= 500000000 && read_int(byte[](terms),8) <= 25400000000);
        require(self.value == read_int(byte[](terms),8)/2 && checkSig(right_sig,right));
        int exposure = read_int(byte[](terms),8)-read_int(byte[](terms),8)/2;
        {
        cov_id prior_game = self.cov_id;
        int prior_side = 0;
        byte[] reserve_proof = byte[]("");
        PlayerState[] next;
        {
        PlayerState q=state(rp.inputs.right0);
        require(read_int(byte[](q.data),8) >= 0);
        require(q.data.slice(8,16) == byte[](read_int(byte[](q.data),8) as byte[8]));
        reserve_proof = reserve_proof + byte[](read_int(byte[](q.data),8) as byte[8]);
        prior_game = q.game; prior_side = q.role/3;
        require(prior_side >= 0 && prior_side <= 1);
        require(q.owner == right && q.role%3 == 0 && read_int(byte[](q.data),0) == chosen_generation);
        require(read_int(byte[](q.data),24) == 0);
        require(tx.outputs[OpCovOutputIdx(chosen_pool,0)].value >= read_int(byte[](q.data),8)+part(exposure,0));
        next=next.append(PlayerState {owner:q.owner,role:3+q.role%3,game:self.cov_id,
            data:byte[120](byte[](chosen_generation as byte[8])+q.data.slice(8,16)+byte[](part(exposure,0) as byte[8])+byte[](1 as byte[8])+byte[](0 as byte[8])+byte[](16 as byte[8])+zero72())});
        }
        {
        PlayerState q=state(rp.inputs.right1);
        require(read_int(byte[](q.data),8) >= 0);
        require(q.data.slice(8,16) == byte[](read_int(byte[](q.data),8) as byte[8]));
        reserve_proof = reserve_proof + byte[](read_int(byte[](q.data),8) as byte[8]);
        require(q.owner == right && q.role%3 == 1 && read_int(byte[](q.data),0) == chosen_generation);
        require(read_int(byte[](q.data),24) == 0);
        require(tx.outputs[OpCovOutputIdx(chosen_pool,1)].value >= read_int(byte[](q.data),8)+part(exposure,1));
        next=next.append(PlayerState {owner:q.owner,role:3+q.role%3,game:self.cov_id,
            data:byte[120](byte[](chosen_generation as byte[8])+q.data.slice(8,16)+byte[](part(exposure,1) as byte[8])+byte[](1 as byte[8])+byte[](0 as byte[8])+byte[](16 as byte[8])+zero72())});
        }
        {
        PlayerState q=state(rp.inputs.right2);
        require(read_int(byte[](q.data),8) >= 0);
        require(q.data.slice(8,16) == byte[](read_int(byte[](q.data),8) as byte[8]));
        reserve_proof = reserve_proof + byte[](read_int(byte[](q.data),8) as byte[8]);
        require(q.owner == right && q.role%3 == 2 && read_int(byte[](q.data),0) == chosen_generation);
        require(read_int(byte[](q.data),24) == 0);
        require(tx.outputs[OpCovOutputIdx(chosen_pool,2)].value >= read_int(byte[](q.data),8)+part(exposure,2));
        next=next.append(PlayerState {owner:q.owner,role:3+q.role%3,game:self.cov_id,
            data:byte[120](byte[](chosen_generation as byte[8])+q.data.slice(8,16)+byte[](part(exposure,2) as byte[8])+byte[](1 as byte[8])+byte[](0 as byte[8])+byte[](16 as byte[8])+zero72())});
        }
        require rp.outputs become { right0 <- Lane(next[0]), right1 <- Lane(next[1]), right2 <- Lane(next[2]), };
        // Disclosure is consensus-enforced: a signed but absent or false proof
