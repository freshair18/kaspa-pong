+// Pong supplies one authenticated Bank template frame in the transaction payload.
+fn shared_bank_witness_entry(model: &Model<'_>, actor: &ActorDecl, entry: &EntryDecl) -> bool {
+    model.app_name == "ReusablePong"
+        && std::env::var_os("ARGENT_SHARE_PONG_BANK_TEMPLATE").is_some_and(|value| value == "1")
+        && matches!(
+            (actor.name.as_str(), entry.name.as_str()),
+            ("Lane", "reset_primary") | ("Lobby", "cancel") | ("Collector", "collect")
+        )
+}
+
+// Ordinary contacts omit the Collector template. The terminal branch
+// authenticates the supplied template with the generated output check.
+fn optional_collector_witness_entry(model: &Model<'_>, actor: &ActorDecl, entry: &EntryDecl) -> bool {
+    model.app_name == "ReusablePong"
+        && std::env::var_os("ARGENT_SHARE_PONG_BANK_TEMPLATE").is_some_and(|value| value == "1")
+        && actor.name == "Court"
+        && entry.name == "resolve"
+}
